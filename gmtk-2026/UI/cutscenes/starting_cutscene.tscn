[sub_resource type="Resource" id="Resource_got86"]
script = ExtResource("2_3yu11")
speaker = "Narrator"
body = "A long time ago, in the magical kingdom of Slough, there were two powerful wizards: joe wizard and john wizard. For centuries, they had a bitter feud, until one day, John Wizard found a powerful spell..."
metadata/_custom_type_script = "uid://b01xvucl3mvta"

[sub_resource type="Resource" id="Resource_wxb4a"]
script = ExtResource("2_3yu11")
speaker = "John Wizard"
body = "HAHAHAHA, finally... this spell will put Joe Wizard in his place, and i'll be the most powerful wizard in Slough that has a name starting with J!"
metadata/_custom_type_script = "uid://b01xvucl3mvta"

[sub_resource type="Resource" id="Resource_6oyhc"]
script = ExtResource("2_3yu11")
speaker = "Narrator"
body = "And so one day, while Joe Wizard was sleeping, John Wizard placed a spell on him, such that he would age rapidly if he doesn't get blood from someone else."
metadata/_custom_type_script = "uid://b01xvucl3mvta"

[sub_resource type="Resource" id="Resource_tu1um"]
script = ExtResource("2_3yu11")
speaker = "Joe Wizard"
body = "Nooooo! John Wizard has placed a spell on me that I age rapidly if I don't get blood from someone else! I must ascend his tower and kill him to remove  this spell!"
metadata/_custom_type_script = "uid://b01xvucl3mvta"

[sub_resource type="Resource" id="Resource_yk36w"]
script = ExtResource("2_3yu11")
speaker = "Narrator"
body = "So now, Joe Wizard must climb John Wizard's tower and face him, to remove his spell."
metadata/_custom_type_script = "uid://b01xvucl3mvta"

